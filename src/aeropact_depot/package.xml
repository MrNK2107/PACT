<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aeropact_depot</name>
  <version>0.1.0</version>
  <description>
    Depot node: a local resource, not a controller (PRD 3.2). Order intake, physical parcel hand-off
    arbitration with fencing tokens, charging-pad arbitration, re-orders of lost parcels, and a full
    replica participating in gossip.
  </description>
  <maintainer email="venkat@proudindian.ngo">AeroPACT Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>aeropact_agent</depend>
  <depend>aeropact_core</depend>
  <depend>aeropact_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
