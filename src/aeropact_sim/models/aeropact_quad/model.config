<?xml version="1.0"?>
<model>
  <name>aeropact_quad</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>AeroPACT Maintainers</name></author>
  <description>
    X3-class quadrotor (1.5 kg) with Gazebo multicopter motor models, velocity controller and
    odometry publisher. The world generator inlines one copy per vehicle with its own namespace;
    this standalone copy (namespace "quad") is for inspection and manual tests.
  </description>
</model>
