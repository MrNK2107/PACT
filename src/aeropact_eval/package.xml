<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aeropact_eval</name>
  <version>0.1.0</version>
  <description>
    Evaluation tooling: structured event recorder, metrics and invariant checks computed from the
    event log only (REQ-EVAL-003), the policy x baseline x seed benchmark runner with plots and a
    summary report (REQ-EVAL-002/004), and an RViz fleet monitor (REQ-VIZ-001).
  </description>
  <maintainer email="venkat@proudindian.ngo">AeroPACT Maintainers</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>aeropact_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
