<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aeropact_radio</name>
  <version>0.1.0</version>
  <description>
    Mesh radio bridge for deployed vehicles and depots: carries RadioFrames over a real IP network
    (UDP multicast or unicast) with fleet authentication (HMAC-SHA256) and replay protection, in
    place of the simulated radio medium. Includes the fleet key generator.
  </description>
  <maintainer email="venkat@proudindian.ngo">AeroPACT Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>aeropact_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>libssl-dev</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
