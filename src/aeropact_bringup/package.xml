<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aeropact_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files, system presets, the scenario suite and the scenario acceptance tests (AT-xx) of
    AeroPACT. One launch file brings up a whole run: world generation, physics (Gazebo Harmonic or
    the kinematic backend), simulated radio/plant/sensing, depots, the fleet (one component
    container per vehicle), the optional central hub, fault script, workload and event recorder.
  </description>
  <maintainer email="venkat@proudindian.ngo">AeroPACT Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>aeropact_agent</exec_depend>
  <exec_depend>aeropact_baselines</exec_depend>
  <exec_depend>aeropact_depot</exec_depend>
  <exec_depend>aeropact_eval</exec_depend>
  <exec_depend>aeropact_safety</exec_depend>
  <exec_depend>aeropact_sim</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
